NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://oracle:oracle@localhost:5432/oracle
# Keep staging and production secrets/databases separate.
APP_ENV=development
REGISTRATION_ENABLED=true
# Prefer Railway private networking. For external TLS connections set require.
DATABASE_SSL=disable
# Optional operator-selected account: provision an existing user at migration time.
# BOOTSTRAP_SUPERUSER_EMAIL=operator@example.com
# Only needed to claim a reserved account that does not exist yet. Keep secret.
# BOOTSTRAP_SUPERUSER_SETUP_TOKEN=<at-least-32-random-characters>
