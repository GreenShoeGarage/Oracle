{
  "name": "oracle-larp-field-kit",
  "version": "0.8.0",
  "private": true,
  "description": "ORACLE — LARP Field Kit. Themed adventures, cooperative challenges, fictional readings, and shared field instruments.",
  "type": "module",
  "engines": {
    "node": ">=22.9.0 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "verify": "npm run check && npm test",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "fake-indexeddb": "6.2.5"
  }
}
