{
  "name": "oracle-larp-field-kit",
  "version": "1.9.0",
  "private": true,
  "description": "ORACLE — LARP Field Kit. Themed adventures, unified Field Home, connection cards, character arcs, community projects, verified contributions, bounded consequences, complete starter experiences, and offline field resilience.",
  "type": "module",
  "engines": { "node": ">=22.9.0 <25" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "check": "node scripts/check.js",
    "tour:build": "node scripts/build-tour.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "verify": "npm run check && npm test",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": { "pg": "8.16.3" },
  "devDependencies": { "@electric-sql/pglite": "0.5.8", "fake-indexeddb": "6.2.5", "jsdom": "26.1.0" }
}
